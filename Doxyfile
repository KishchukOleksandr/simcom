# Doxygen configuration file for libsimcom

PROJECT_NAME           = "libsimcom"
PROJECT_NUMBER         = "1.0.0"
PROJECT_BRIEF          = "Zero-Allocation Non-Blocking Cellular Modem Driver for Bare-Metal MCUs"
OUTPUT_DIRECTORY       = docs/generated

# Input sources
INPUT                  = docs/index.md \
                         docs/algorithms.md \
                         docs/examples.md \
                         docs/rpi5_a7670e.md \
                         docs/base_cmd.md \
                         inc \
                         examples/rpi5_a7670e/rpi5_app.h \
                         examples/rpi5_a7670e/rpi5_platform.h \
                         README.md

USE_MDFILE_AS_MAINPAGE = docs/index.md
RECURSIVE              = YES
FILE_PATTERNS          = *.h *.md
EXCLUDE_PATTERNS       = */build/* */.git/*

# Language & extraction settings
OPTIMIZE_OUTPUT_FOR_C  = YES
EXTRACT_ALL            = YES
EXTRACT_STATIC         = NO
EXTRACT_LOCAL_CLASSES  = NO
SHOW_INCLUDE_FILES     = YES
FULL_PATH_NAMES        = NO
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
SORT_MEMBER_DOCS       = YES
TAB_SIZE               = 4

# HTML Generation & modern layout
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
HTML_COLORSTYLE        = AUTO_LIGHT
HTML_COLORSTYLE_HUE    = 210
HTML_COLORSTYLE_SAT    = 100
HTML_COLORSTYLE_GAMMA  = 80
GENERATE_TREEVIEW      = YES
TREEVIEW_WIDTH         = 280
DISABLE_INDEX          = NO
SEARCHENGINE           = YES

# Disable unused output formats
GENERATE_LATEX         = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO

# Graphviz / Dot diagrams
HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = NO
GRAPHICAL_HIERARCHY    = YES
DIRECTORY_GRAPH        = YES

# Warnings & diagnostics
QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
